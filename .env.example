SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Display name; defaults to DAEHO.
APP_DISPLAY_NAME=DAEHO
# Set a long random password to enable access protection. Empty means no password gate.
APP_PASSWORD=

# Local Meritz connection test: npm run test:meritz (Node 22+)
# Obtain credentials at https://openapi.imeritz.com/api-apply
MERITZ_APP_KEY=
MERITZ_APP_SECRET=
# Optional; automatically uses a local network interface MAC when omitted.
MERITZ_MAC_ADDRESS=
# Order script defaults to preview. Actual sending also requires --send.
MERITZ_READ_ONLY=1

# App broker orders require APP_PASSWORD in production; the key stays server-side.
# Generate once with npm run setup:broker:push, then copy these to Vercel.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# HTTPS address of your own deployed app, or your own mailto contact.
VAPID_SUBJECT=
